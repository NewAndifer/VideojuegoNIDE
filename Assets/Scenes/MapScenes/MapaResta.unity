--- !u!1001 &4583239585031254216
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: npcNameText
      value: 
      objectReference: {fileID: 1426477760}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 4713618460142360827}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 2650062754984447182}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: lineasNormales.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[0]'
      value: "\xA1Llegaste justo a tiempo, {PlayerName}! El rastro de Terry se est\xE1
        perdiendo en este ca\xF1\xF3n de ecos"
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[1]'
      value: "Restar es lo opuesto a sumar. Se trata de quitar una cantidad a lo
        que ya ten\xEDas para saber cu\xE1nto te queda"
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[2]'
      value: "Imagina que tienes 10 manzanas para el viaje, pero te comes 4. Ahora
        solo te quedan 6. El n\xFAmero se hace peque\xF1o"
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[3]'
      value: "Usa el signo - para descubrir cu\xE1nto nos han quitado. \xA1No dejes
        que borren tu rastro"
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[4]'
      value: "S\xE9 por qu\xE9 est\xE1s aqu\xED, {PlayerName}. No puedes borrar que
        antes usabas tus sumas para contar el bot\xEDn de Terry."
      objectReference: {fileID: 0}
    - target: {fileID: 522185508062084206, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: 'lineasNormales.Array.data[5]'
      value: "Pero devolviendo lo robado ... as\xED es como se empieza de nuevo."
      objectReference: {fileID: 0}
    - target: {fileID: 3412230320921171446, guid: 575d0924c6911438fbb729dbd79ccfac, type: 3}
      propertyPath: m_LocalPosition.x
      value: 7.91
      objectReference: {fileID: 0}
