<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/BossViewStyle.uss?fileID=7433441132597879392&amp;guid=60836e3487c866065bf7267c81037552&amp;type=3#BossViewStyle"/>
    <ui:VisualElement name="LifesContainer" picking-mode="Ignore" style="flex-grow: 1; padding-left: 30px; padding-top: 20px; flex-direction: row;">
        <ui:Image name="Life1" class="Heart life"/>
        <ui:Image name="Life2" class="Heart life"/>
        <ui:Image name="Life3" class="Heart life"/>
    </ui:VisualElement>
    <ui:VisualElement name="Time" picking-mode="Ignore" style="flex-grow: 1; align-items: flex-end; justify-content: flex-start;">
        <ui:VisualElement name="TimeContainer" style="flex-grow: 1; width: 100%; height: 1000%; background-color: rgba(10, 9, 9, 0);">
            <ui:Label text="00:00" name="TimeCount" style="background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0); -unity-text-align: middle-center; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(103, 103, 103, 0); border-right-color: rgba(103, 103, 103, 0); border-top-color: rgba(103, 103, 103, 0); border-bottom-color: rgba(103, 103, 103, 0); padding-right: 10px; padding-left: 10px; -unity-font-style: normal; margin-top: 20px; margin-right: 30px; max-height: none; min-height: 50px; font-size: 80px; -unity-font-definition: url(&quot;project://database/Assets/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&amp;guid=71a55b0538d48354b87afab937af74d2&amp;type=3#BoldPixels&quot;); width: 35%; align-self: flex-end; background-image: url(&quot;project://database/Assets/Cowboy%20Cats/Untitled%204.png?fileID=-2401453818774780720&amp;guid=52383d200f78a4551836d2ca757c6796&amp;type=3#Untitled 4_5&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
