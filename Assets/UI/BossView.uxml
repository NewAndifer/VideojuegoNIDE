<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/BossViewStyle.uss?fileID=7433441132597879392&amp;guid=60836e3487c866065bf7267c81037552&amp;type=3#BossViewStyle"/>
    <ui:VisualElement name="LifesContainer" picking-mode="Ignore" style="flex-grow: 1; padding-left: 30px; padding-top: 20px; flex-direction: row;">
        <ui:Image name="Life1" class="Heart"/>
        <ui:Image name="Life2" class="Heart"/>
        <ui:Image name="Life3" class="Heart"/>
    </ui:VisualElement>
    <ui:VisualElement name="Time" picking-mode="Ignore" style="flex-grow: 1; align-items: flex-end; justify-content: flex-start;">
        <ui:VisualElement name="TimeContainer" style="flex-grow: 1; width: 150px; height: auto; background-color: rgba(10, 9, 9, 0);">
            <ui:Label text="Label" name="TimeCount" style="background-color: rgba(0, 0, 0, 0.39); color: rgb(255, 255, 255); -unity-text-align: middle-center; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(103, 103, 103); border-right-color: rgb(103, 103, 103); border-top-color: rgb(103, 103, 103); border-bottom-color: rgb(103, 103, 103); padding-right: 10px; padding-left: 10px; -unity-font-style: bold; margin-top: 20px; margin-right: 30px; max-height: none; min-height: 50px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&amp;guid=71a55b0538d48354b87afab937af74d2&amp;type=3#BoldPixels&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
