.panel-tutorial-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85); /* Un fondo más oscuro para resaltar el panel */
    justify-content: center;
    align-items: center;
    display: none; 
}

.panel-tutorial-contenedor {
    width: 80%; 
    height: 80%; 
    background-color: #d1a773; 
    border-width: 15px;
    border-color: #3b250e; 
    border-radius: 0px; /* Bordes rectos para un estilo más pixel-art */
    padding: 30px;
    flex-direction: column;
}

.panel-tutorial-contenido {
    flex-grow: 1; 
    margin-bottom: 20px;
}

.panel-tutorial-imagen {
    flex-grow: 1; /* Le dice que ocupe el espacio vertical sobrante */
    width: 100%; /* ¡Esto es la clave! Obliga a la imagen a estirarse a lo ancho */
    margin-top: 20px; /* Un poco de espacio para separarla del texto de arriba */
    margin-bottom: 20px;
    -unity-background-scale-mode: scale-to-fit; /* Hace que crezca todo lo posible sin deformarse ni perder su proporción original */
}

.panel-tutorial-texto {
    font-size: 50px; /* Tamaño más grande */
    color: rgb(30, 20, 10);
    white-space: normal; 
    -unity-text-align: middle-center;
    /* Aplicando tu fuente personalizada */
    -unity-font-definition: url("project://database/Assets/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&guid=71a55b0538d48354b87afab937af74d2&type=3#BoldPixels");
}

.panel-tutorial-controles {
    height: 150px;
    flex-direction: row;
    justify-content: space-around; 
    align-items: center;
}

/* Aplicando el estilo de tus botones principales */
.panel-tutorial-boton-navegacion {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&guid=71a55b0538d48354b87afab937af74d2&type=3#BoldPixels");
    width: 350px;
    height: 110px;
    align-items: center;
    align-self: center;
    /* Tu imagen normal */
    background-image: url("project://database/Assets/Cowboy%20Cats/Untitled%204.png?fileID=-2401453818774780720&guid=52383d200f78a4551836d2ca757c6796&type=3#Untitled 4_5");
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(0, 0, 0); /* Letra en negro para que contraste con la madera */
}

.panel-tutorial-boton-navegacion:hover {
    /* Tu imagen de hover */
    background-image: url("project://database/Assets/Cowboy%20Cats/Untitled%204.png?fileID=2935242376306719514&guid=52383d200f78a4551836d2ca757c6796&type=3#Untitled 4_6");
}