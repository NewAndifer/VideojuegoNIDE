:root {
}

.contenedorPrincipal {
    min-width: 100%;
    min-height: 100%;
    justify-content: space-evenly;
    align-self: center;
    align-items: flex-end;
    flex-direction: row;
    align-content: center;
}

.boton {
    font-size: 60px;
    -unity-font-definition: url("project://database/Assets/BoldPixels/Assets/font/BoldPixels.ttf?fileID=12800000&guid=71a55b0538d48354b87afab937af74d2&type=3#BoldPixels");
    width: 450px;
    align-items: center;
    align-self: center;
    background-image: url("project://database/Assets/Cowboy%20Cats/Untitled%204.png?fileID=-2401453818774780720&guid=52383d200f78a4551836d2ca757c6796&type=3#Untitled 4_5");
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    height: 130px;
}

.botones {
    justify-content: space-around;
    width: 100%;
    height: 40%;
    margin-bottom: 6%;
    align-self: flex-start;
}

.boton:hover {
    background-image: url("project://database/Assets/Cowboy%20Cats/Untitled%204.png?fileID=2935242376306719514&guid=52383d200f78a4551836d2ca757c6796&type=3#Untitled 4_6");
}

.contenedorCreditos {
}

.contenedorTercio {
    height: 100%;
    width: 30%;
    justify-content: flex-end;
}

.creditos {
    height: 40%;
    justify-content: flex-end;
    width: 100%;
    margin-bottom: 6%;
}
