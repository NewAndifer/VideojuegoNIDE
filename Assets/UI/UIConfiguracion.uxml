<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UIConfiguracion.uss?fileID=7433441132597879392&amp;guid=0c18f9651a54b4feda5abaceb3722606&amp;type=3#UIConfiguracion"/>
    <ui:VisualElement name="ContenedorPrincipal" class="contenedorPrincipal" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="ContenedorRelleno" class="contenedorRelleno" style="flex-grow: 1;"/>
        <ui:VisualElement name="ContenedorConfiguracion" class="contenedorConfiguracion">
            <ui:Label text="Opciones" name="LabelOpciones" class="opciones"/>
            <ui:VisualElement name="ContenedorSlider" class="contenedorSlider">
                <ui:Label text="Efectos de sonido" name="LabelEfectoSonido" class="labelSlider"/>
                <ui:Slider label="" value="1" high-value="1" low-value="0.001" name="SliderEfectosSonido"/>
                <ui:Label text="Música" name="LabelMusica" class="labelSlider"/>
                <ui:Slider label="" value="1" high-value="1" low-value="0.001" name="SliderMusica"/>
            </ui:VisualElement>
            <ui:Button text="Volver" name="BotonVolver" class="boton"/>
        </ui:VisualElement>
        <ui:VisualElement name="ContenedorRelleno" class="contenedorRelleno" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
