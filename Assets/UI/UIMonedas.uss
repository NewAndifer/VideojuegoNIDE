:root {
}

.contenedorPrincipal {
    min-width: 100%;
    min-height: 100%;
    width: 100%;
    height: 100%;
}

.contenedorGeneralMonedas {
    height: 15%;
    flex-direction: row;
    align-self: center;
    justify-content: space-around;
    min-width: 100%;
    max-width: 100%;
}

.contenedorMonedas {
    flex-direction: row;
    justify-content: center;
    align-self: center;
    min-width: 30%;
    max-width: 30%;
    min-height: 100%;
    max-height: 100%;
    align-items: center;
    -unity-text-align: upper-center;
    align-content: center;
}

.numMonedas {
    font-size: 70px;
    align-self: center;
}

.contenedorRelleno {
    min-width: 30%;
    max-width: 30%;
}

.imagenMonedas {
    height: 80%;
    width: 30%;
}
